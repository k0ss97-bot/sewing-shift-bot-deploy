{
    servers {
        protocols h1 h2
        max_header_size 64KB
        timeouts {
            read_body 60s
            read_header 10s
            write 120s
            idle 2m
        }
    }
}

www.shagaemfabrika.ru {
    encode zstd gzip

    header {
        -Server
        Alt-Svc "clear"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "same-origin"
        # The application generates CSP hashes from the exact HTML release.
        # Do not override that dynamic policy at the reverse proxy.
    }

    request_body {
        max_size 16MB
    }

    reverse_proxy 127.0.0.1:3000
}

shagaemfabrika.ru {
    redir https://www.shagaemfabrika.ru{uri} permanent
}

