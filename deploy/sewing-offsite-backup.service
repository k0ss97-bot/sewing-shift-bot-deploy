[Unit]
Description=Replicate verified Sewing backups to an independent mounted target
After=sewing-web-backup.service sewing-wms-backup.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/sewing-web/current
EnvironmentFile=/etc/sewing-web/offsite-backup.env
Environment=BACKUP_OFFSITE_STATUS_PATH=/var/lib/sewing-web/monitor/offsite-backup-status.json
ExecStart=/opt/sewing-web/venv/bin/python /opt/sewing-web/current/scripts/replicate_backups_offsite.py
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
ReadOnlyPaths=/var/lib/sewing-web/backups /var/backups/sewing-wms
ReadWritePaths=/mnt/sewing-offsite /var/lib/sewing-web/monitor
