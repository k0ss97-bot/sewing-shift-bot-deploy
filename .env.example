# Telegram credentials. Keep real values only in the untracked .env file.
BOT_TOKEN=
ADMIN_IDS=

# Public Telegram Mini App URL. WEBAPP_URL is a backwards-compatible fallback.
MINIAPP_URL=
# WEBAPP_URL=

# Embedded HTTP server.
MINIAPP_HOST=0.0.0.0
MINIAPP_PORT=3000
# PORT=3000
MINIAPP_ENABLED=1

# Never enable debug authentication in a public or production environment.
MINIAPP_DEBUG=0

# Standalone web sessions. Production mode requires an HTTPS public origin,
# Secure cookies, and disabled debug authentication.
WEBAPP_ENV=production
WEBAPP_PUBLIC_ORIGIN=https://app.example.ru
WEBAPP_SERVER_SECRET=replace-with-at-least-32-random-characters
# Default: 12-hour absolute lifetime and logout after 45 minutes of inactivity.
WEBAPP_SESSION_TTL_SECONDS=43200
WEBAPP_SESSION_IDLE_SECONDS=2700
WMS_DB_POOL_MAX=12
WMS_DB_POOL_TIMEOUT_SECONDS=5
ANALYTICS_READ_MODEL_CACHE_TTL_SECONDS=15
WEBAPP_COOKIE_SECURE=1
WEBAPP_BACKUP_RETENTION=14
# Defect metadata remains in the audit trail; only the private photo payload is
# removed after this period. Allowed range: 30–3650 days.
DEFECT_PHOTO_RETENTION_DAYS=365
# These values are evidence, not encryption switches. Set them only after the
# database/private-blob/backup volumes were verified as encrypted.
DATA_AT_REST_ENCRYPTION_CONFIRMED=0
DATA_AT_REST_ENCRYPTION_PROVIDER=
DATA_AT_REST_ENCRYPTION_EVIDENCE_ID=
# Off-site replication is fail-closed unless this recent marker exists on the
# independent encrypted mount.
BACKUP_OFFSITE_ENCRYPTION_MARKER=.encryption-at-rest.json

# Enable only behind a controlled proxy that sanitizes X-Forwarded-* headers.
TRUST_PROXY_HEADERS=0

# Required for deployment: replace with a private, persistent absolute path.
DB_DIR=/absolute/path/to/private/sewing-web-data
# SHARED_DIR=/absolute/path/to/legacy-shared-data

# Read-only marketplace snapshots. Keep keys only in the private server env.
# The marketplace screen never sends prices, cards, stocks or orders back.
# Необязательная внутренняя подпись кабинета (на Ozon не отправляется).
# OZON_ACCOUNT_NAME=Основной Ozon
OZON_CLIENT_ID=
OZON_API_KEY=
# Wildberries is reserved for the next connector; do not put a WB token here
# until the WB adapter is enabled.
WB_ACCOUNT_NAME=Основной Wildberries
WB_API_TOKEN=
# Обязателен для Базового/Сервисного токена, если WB требует подпись сервиса.
WB_CLIENT_SECRET=
WEBAPP_GRACEFUL_SHUTDOWN_SECONDS=25
