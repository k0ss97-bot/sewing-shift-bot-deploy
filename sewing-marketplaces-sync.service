[Unit]
Description=Shagaem Vmeste read-only marketplace synchronization
After=network-online.target sewing-web.service
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/opt/sewing-web/current
EnvironmentFile=/etc/sewing-web/sewing-web.env
ExecStart=/opt/sewing-web/venv/bin/python /opt/sewing-web/current/marketplace_sync_cli.py
TimeoutStartSec=1800
Nice=10
MemoryMax=1G
OOMPolicy=stop

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sewing-web
